{
  "name": "jwt-jwe-lambdas",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "AWS Lambda Functions for JWT signing/verification and JWE encryption/decryption",
  "main": "src/encryptor/handler.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='tests/unit'",
    "test:property": "jest --testPathPattern='tests/property'",
    "deploy:alvaro": "sam deploy --stack-name jwt-jwe-lambdas-alvaro --region us-east-1 --profile alvaro-mejia --capabilities CAPABILITY_IAM --resolve-s3",
    "deploy:alvaro:guided": "sam deploy --guided --profile alvaro-mejia --region us-east-1 --capabilities CAPABILITY_IAM"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.1058.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "fast-check": "^3.22.0",
    "jest": "^29.7.0"
  }
}
